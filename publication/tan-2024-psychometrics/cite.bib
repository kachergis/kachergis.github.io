 author = {Tan, A. W. M. and Kachergis, G. and Frank, M. C.},
 booktitle = {Proceedings of the 46th Annual Conference of the Cognitive Science Society},
 title = {Using Psychometrics to Improve Cognitive Models--and Theory},
