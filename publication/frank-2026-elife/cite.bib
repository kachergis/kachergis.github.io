@article{Frank2026elife,
 abstract = {Using data from Peekbank, an open database of eye-tracking experiments measuring children's word recognition, we analyzed 26 datasets from over 2,500 children ages 6 months to 6 years. Word recognition becomes faster, more accurate, and less variable across development, consistent with a process of skill learning. Factor analysis revealed covariation of word recognition speed and accuracy with children's vocabulary size, and across longitudinal models, speed, accuracy, and vocabulary were coupled. Children with overall faster word recognition tended to show faster vocabulary growth, though developmental growth in word recognition skill was not specifically associated with growth in vocabulary. These findings support viewing word recognition as a gradually developing skill intertwined with early language learning.},
 author = {Frank, M. C. and Marchman, V. A. and Bergey, C. A. and Boyce, V. and Braginsky, M. and Kachergis, G. and Others and Zettersten, M.},
 doi = {10.7554/eLife.109636.3},
 journal = {eLife},
 title = {Continuous developmental changes in word recognition and language learning across early childhood},
 url = {https://elifesciences.org/articles/109636},
 year = {2026}
}
